<% layout("/layouts/boilerplate") %>

<div class="text-center mt-4 mb-5">
    <h1><i class="fa-solid fa-calendar-check text-danger"></i> My Bookings</h1>
    <p class="text-muted">All your confirmed reservations</p>
</div>

<% if(bookings.length === 0) { %>
    <div class="text-center mt-5">
        <i class="fa-regular fa-calendar-xmark fa-4x text-danger mb-3"></i>
        <h3>No bookings yet</h3>
        <p class="text-muted">Reserve your favorite stays and they will appear here.</p>
        <a href="/listings" class="btn btn-dark rounded-pill">Explore Listings</a>
    </div>
<% } else { %>

<div class="row justify-content-center">
    <% for(let booking of bookings) { %>
        <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
            <div class="card booking-card shadow-sm h-100">

                <a href="/listings/<%= booking.listing._id %>">
                    <img
                        src="<%= booking.listing.image.url %>"
                        class="card-img-top booking-card-img"
                        alt="<%= booking.listing.title %>"
                    >
                </a>

                <div class="card-body ">
                    <h4 class="booking-title">
                        <%= booking.listing.title %>
                    </h4>

                    <p class="text-muted mb-2">
                        <i class="fa-solid fa-location-dot text-danger"></i>
                        <%= booking.listing.location %>, <%= booking.listing.country %>
                    </p>

                    <div class="booking-info">
                        <p><b>Check In:</b> <%= booking.checkIn.toDateString() %></p>
                        <p><b>Check Out:</b> <%= booking.checkOut.toDateString() %></p>
                        <p><b>Guests:</b> <%= booking.guests %></p>
                    </div>

                    <hr>

                    <p class="booking-total">
                        Total: ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
                        <span><b>(including GST)</b></span>
                    </p>

                    <form method="POST" action="/bookings/<%= booking._id %>?_method=DELETE">
                    <button class="btn btn-outline-danger w-100 mt-2">
                     Cancel Booking
                    </button>
                    </form>
                </div>

            </div>
        </div>
    <% } %>
</div>

<% } %>