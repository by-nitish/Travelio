<% layout("/layouts/boilerplate") %>

<style>
.listing-card {
    border: none;
    transition: all 0.3s ease;
}

.listing-card:hover {
    transform: translateY(-8px);
}

.listing-links {
    text-decoration: none;
    color: #222222;
}

.card-img-top {
    border-radius: 1rem;
}

.card-footer {
    background: transparent;
}

</style>

<div class="text-center mt-4 mb-5">
    <h1>❤️ My Wishlist</h1>
    
</div>

<% if(user.favorites.length === 0) { %>

<div class="text-center mt-5">
    <i class="fa-regular fa-heart fa-4x text-danger mb-3"></i>
    <h3>Your wishlist is empty</h3>
    <p class="text-muted">
        Save your favorite stays and they'll appear here.
    </p>
    <a href="/listings" class="btn btn-dark rounded-pill mt-2">
        Explore Listings
    </a>
</div>
<% } else { %>
  <div class="row justify-content-center">
    <% for(let listing of user.favorites) { %>

        <div class="col-lg-4 col-md-6 col-sm-12 mb-4">

            <div class="card listing-card shadow-sm h-100">

                <a href="/listings/<%= listing._id %>" class="listing-links">
                    <img
                        src="<%= listing.image.url %>"
                        class="card-img-top"
                        alt="listing_image"
                        style="height:18rem; object-fit:cover;"
                    >

                    <div class="card-body">
                        <h5><%= listing.title %></h5>

                        <p class="card-text">
                            &#8377;
                            <%= listing.price.toLocaleString("en-IN") %>
                            / night
                        </p>
                    </div>
                </a>

                <div class="card-footer bg-white border-0 text-center mb-2">

                    <form
                        method="POST"
                        action="/listings/<%= listing._id %>/wishlist/remove"
                    >
                        <button
                            class="btn btn-outline-danger rounded-pill px-4"
                        >
                            <i class="fa-solid fa-heart-crack"></i>
                            Remove
                        </button>
                    </form>

                </div>

            </div>

        </div>

    <% } %>
</div>
<% } %>